[Unit]
Description=Check the ninfer request log size and roll it over if over 1 GiB

[Timer]
# Fire at 00:00, 06:00, 12:00, 18:00 every day (hour 00 step 6). NOTE: the
# shorthand "*:00/6" means every 6 *minutes*, not 6 hours.
OnCalendar=*-*-* 00/6:00:00
Persistent=true

[Install]
WantedBy=timers.target
